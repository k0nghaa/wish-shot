# Supabase 접속 정보 (앱에는 anon/publishable 키만 넣는다 — service_role 금지)
# 실제 값은 .env 파일에 넣고, .env는 커밋하지 않는다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# PostHog 테스트 계측(Phase 10) — write-only 공개 키라 EXPO_PUBLIC 노출 안전.
# 미설정 시 계측은 전부 no-op(앱 동작 불변). EAS 환경에도 같은 값을 등록한다(eas env:set 또는 expo.dev 웹).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry 오류·크래시 수집 — DSN 은 공개 값. 미설정 시 수집은 전부 no-op(앱 동작 불변).
# __DEV__ 에서는 기본 비활성이다. 검증할 때만 EXPO_PUBLIC_SENTRY_DEV=1 로 켠다.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEV=
# SENTRY_AUTH_TOKEN(소스맵 업로드용)은 EAS 환경 변수(Secret)에만 둔다. 이 파일·.env 에 넣지 않는다.
# EAS 빌드에 토큰이 없으면 Xcode 업로드 단계가 실패해 빌드가 멈춘다(SENTRY_DISABLE_AUTO_UPLOAD=true 로만 건너뜀).
