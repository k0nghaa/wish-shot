# ─────────────────────────────────────────────────────────────────────────────
# WishShot — 환경 변수 예시
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채워넣으세요.
# .env.local 은 .gitignore 에 포함되며 저장소에 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL
# 로컬: http://localhost:54321
# 클라우드: https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon (public) key — Auth API 호출에 사용 (로그인 전용)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — 서버 측 데이터 접근 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 소유자 Supabase Auth UID
# Supabase Studio → Authentication → Users 에서 확인
# 마이그레이션 스크립트(scripts/migrate.ts)와 반드시 동일한 값이어야 합니다
OWNER_UID=your-owner-uid-here

# Supabase Postgres 연결 문자열 — 마이그레이션 스크립트(scripts/migrate.ts)에서 사용
# 로컬: postgresql://postgres:postgres@localhost:54322/postgres
# 클라우드: postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
